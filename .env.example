# Domaine public du site (sert aux URLs canoniques, au sitemap et aux metadonnees Open Graph)
NEXT_PUBLIC_SITE_URL=https://osteopathie-animale.fr

# Formulaire de contact — https://resend.com
# 1. creer un compte, verifier le domaine d'envoi
# 2. generer une cle API et la coller ici
RESEND_API_KEY=

# Adresse qui recoit les demandes de rendez-vous
CONTACT_EMAIL=

# Expediteur affiche (doit appartenir a un domaine verifie chez Resend)
CONTACT_FROM=Site osteopathie animale <contact@osteopathie-animale.fr>
